{
  "title": "1단원 · はじめまして",
  "items": [
    {
      "id": "u1-01",
      "text": "はじめまして。",
      "reading": "はじめまして",
      "meaning": "처음 뵙겠습니다.",
      "group": "자기소개",
      "tip": "は・じ・め・ま・し・て를 일정한 박자로 말해 보세요.",
      "audio": "audio/1_15_1.mp3",
      "sourcePage": "15쪽 · 의사소통 기본 표현"
    },
    {
      "id": "u1-02",
      "text": "キム・ジウです。",
      "reading": "きむじうです",
      "meaning": "김지우입니다.",
      "group": "자기소개",
      "tip": "이름 뒤의 です까지 자연스럽게 이어 말해 보세요.",
      "audio": "audio/1_15_2.mp3",
      "sourcePage": "15쪽 · 의사소통 기본 표현"
    },
    {
      "id": "u1-03",
      "text": "こちらは私の父です。",
      "reading": "こちらはわたしのちちです",
      "meaning": "이쪽은 저의 아버지입니다.",
      "group": "자기소개",
      "tip": "조사 は는 이 문장에서 ‘와’로 읽습니다.",
      "audio": "audio/1_15_3.mp3",
      "sourcePage": "15쪽 · 의사소통 기본 표현"
    },
    {
      "id": "u1-04",
      "text": "おはよう。",
      "reading": "おはよう",
      "meaning": "안녕. (아침 인사)",
      "group": "인사",
      "tip": "끝의 よう를 너무 짧게 끊지 말고 길이를 살려 보세요.",
      "audio": "audio/1_15_4.mp3",
      "sourcePage": "15쪽 · 의사소통 기본 표현"
    },
    {
      "id": "u1-05",
      "text": "じゃあね。",
      "reading": "じゃあね",
      "meaning": "그럼, 또 봐.",
      "group": "인사",
      "tip": "じゃあ의 긴 모음을 살려 친근하게 말해 보세요.",
      "audio": "audio/1_15_5.mp3",
      "sourcePage": "15쪽 · 의사소통 기본 표현"
    },
    {
      "id": "u1-06",
      "text": "いってきます。",
      "reading": "いってきます",
      "meaning": "다녀오겠습니다.",
      "group": "인사",
      "tip": "작은 っ에서 한 박자 멈춘 뒤 て를 말해 보세요.",
      "audio": "audio/1_15_6.mp3",
      "sourcePage": "15쪽 · 의사소통 기본 표현"
    },
    {
      "id": "u1-07",
      "text": "ただいま。",
      "reading": "ただいま",
      "meaning": "다녀왔습니다.",
      "group": "인사",
      "tip": "た・だ・い・ま 네 박자를 의식해서 말해 보세요.",
      "audio": "audio/1_15_7.mp3",
      "sourcePage": "15쪽 · 의사소통 기본 표현"
    },
    {
      "id": "u1-08",
      "text": "韓国",
      "reading": "かんこく",
      "meaning": "한국",
      "group": "기초 어휘",
      "tip": "ん도 한 박자입니다. か・ん・こ・く로 연습하세요.",
      "audio": "audio/1_2_1.mp3",
      "sourcePage": "16쪽 · 듣고 말하기 1"
    },
    {
      "id": "u1-09",
      "text": "から",
      "reading": "から",
      "meaning": "~에서 / ~부터",
      "group": "기초 어휘",
      "tip": "ら에 힘을 과하게 주지 않고 짧게 말해 보세요.",
      "audio": "audio/1_2_2.mp3",
      "sourcePage": "16쪽 · 듣고 말하기 1"
    },
    {
      "id": "u1-10",
      "text": "来ました",
      "reading": "きました",
      "meaning": "왔습니다",
      "group": "기초 어휘",
      "tip": "き・ま・し・た를 자연스럽게 이어 말해 보세요.",
      "audio": "audio/1_2_3.mp3",
      "sourcePage": "16쪽 · 듣고 말하기 1"
    },
    {
      "id": "u1-11",
      "text": "です",
      "reading": "です",
      "meaning": "~입니다",
      "group": "기초 어휘",
      "tip": "예문 소리와 자신의 녹음을 번갈아 들어 보세요.",
      "audio": "audio/1_2_4.mp3",
      "sourcePage": "16쪽 · 듣고 말하기 1"
    },
    {
      "id": "u1-12",
      "text": "ええと",
      "reading": "ええと",
      "meaning": "음, 저…",
      "group": "기초 어휘",
      "tip": "ええ의 길이를 살려 말해 보세요.",
      "audio": "audio/1_2_5.mp3",
      "sourcePage": "16쪽 · 듣고 말하기 1"
    },
    {
      "id": "u1-13",
      "text": "ちゃん",
      "reading": "ちゃん",
      "meaning": "~짱 (친근한 호칭)",
      "group": "기초 어휘",
      "tip": "ちゃ는 한 박자, ん은 한 박자입니다.",
      "audio": "audio/1_2_6.mp3",
      "sourcePage": "16쪽 · 듣고 말하기 1"
    },
    {
      "id": "u1-14",
      "text": "ぼく",
      "reading": "ぼく",
      "meaning": "나 (주로 남성이 쓰는 표현)",
      "group": "기초 어휘",
      "tip": "ぼ・く를 또렷하게 말해 보세요.",
      "audio": "audio/1_2_7.mp3",
      "sourcePage": "16쪽 · 듣고 말하기 1"
    },
    {
      "id": "u1-15",
      "text": "よろしく",
      "reading": "よろしく",
      "meaning": "잘 부탁해",
      "group": "기초 어휘",
      "tip": "よ・ろ・し・く를 일정한 박자로 연습하세요.",
      "audio": "audio/1_2_8.mp3",
      "sourcePage": "16쪽 · 듣고 말하기 1"
    }
  ]
}

