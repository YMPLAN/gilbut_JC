function doGet(){return ContentService.createTextOutput(JSON.stringify({ok:true,service:'gilbut-sheets-v1'})).setMimeType(ContentService.MimeType.JSON);}
function doPost(e){var lock=LockService.getScriptLock(),result;try{if(!e.postData||e.postData.contents.length>2100000)bad_('요청 크기가 너무 큽니다.');if(!lock.tryLock(20000))bad_('저장 요청이 많습니다. 잠시 후 다시 시도하세요.');result={ok:true,data:route_(JSON.parse(e.postData.contents))};}catch(err){result={ok:false,error:String(err.message||'').indexOf('안내: ')===0?err.message.slice(4):'Google 시트 처리에 실패했습니다. 연결과 저장 용량을 확인하고 다시 시도하세요.'};}finally{lock.releaseLock();}return ContentService.createTextOutput(JSON.stringify(result)).setMimeType(ContentService.MimeType.JSON);}

